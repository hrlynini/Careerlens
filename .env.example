# Copy this file to .env and fill in your key. .env is git-ignored.
# Free key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini

# Optional: real job listings by city (free key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in

# Optional: more reliable live job search (free tier, no card): https://app.tavily.com
# Without it, free DuckDuckGo/ddgs search is used.
TAVILY_API_KEY=
